rules_version = '2';

// Firestore rules for NetworkLogger, database "android-telecom-database" (paste into
// Firebase console → Firestore → android-telecom-database → Rules,
// or deploy with `firebase deploy --only firestore:rules`).
//
// Phones sign in anonymously and may only write under their own uid. They never
// read: the server pipeline uses a service account, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/sessions/{sessionId} {
      allow create, update: if request.auth != null && request.auth.uid == uid;

      match /batches/{batchId} {
        allow create: if request.auth != null && request.auth.uid == uid;
      }
      match /background/{rowId} {
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
