{
  "uid": "networklogger-grid",
  "title": "NetworkLogger Coverage Grid",
  "tags": [
    "networklogger",
    "map",
    "grid"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-45d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "gridSize",
        "label": "Grid size",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "27 m : 0.00025, 55 m : 0.0005, 110 m : 0.001, 220 m : 0.002",
        "options": [
          {
            "text": "27 m",
            "value": "0.00025",
            "selected": false
          },
          {
            "text": "55 m",
            "value": "0.0005",
            "selected": true
          },
          {
            "text": "110 m",
            "value": "0.001",
            "selected": false
          },
          {
            "text": "220 m",
            "value": "0.002",
            "selected": false
          }
        ],
        "current": {
          "selected": true,
          "text": "55 m",
          "value": "0.0005"
        }
      },
      {
        "name": "minSamples",
        "label": "Min samples/cell",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "1 : 1, 3 : 3, 5 : 5, 10 : 10, 20 : 20",
        "options": [
          {
            "text": "1",
            "value": "1",
            "selected": false
          },
          {
            "text": "3",
            "value": "3",
            "selected": true
          },
          {
            "text": "5",
            "value": "5",
            "selected": false
          },
          {
            "text": "10",
            "value": "10",
            "selected": false
          },
          {
            "text": "20",
            "value": "20",
            "selected": false
          }
        ],
        "current": {
          "selected": true,
          "text": "3",
          "value": "3"
        }
      },
      {
        "name": "deviceId",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "P7C70A67DE99A08E6"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"network_logs_v2\", tag: \"deviceId\", start: -365d)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Jio \u2014 median RSRP per cell",
      "description": "Each square is one $gridSize\u00b0-wide grid cell; its colour is the median RSRP of every Jio sample inside it in the time range (hover for the value, the quality class and the sample count). Cells with fewer than $minSamples samples are hidden.",
      "datasource": {
        "type": "influxdb",
        "uid": "P7C70A67DE99A08E6"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P7C70A67DE99A08E6"
          },
          "query": "base = from(bucket: \"network_logs_v2\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_log\")\n  |> filter(fn: (r) => r.op == \"Jio\")\n  |> filter(fn: (r) => r.deviceId =~ /^${deviceId:regex}$/)\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\" or r._field == \"rsrp\")\n  |> aggregateWindow(every: 30s, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon and exists r.rsrp)\n  |> map(fn: (r) => ({r with\n      cellLat: string(v: (float(v: int(v: r.lat / ${gridSize})) + 0.5) * ${gridSize}),\n      cellLon: string(v: (float(v: int(v: r.lon / ${gridSize})) + 0.5) * ${gridSize})}))\n  |> group(columns: [\"cellLat\", \"cellLon\"])\n\nmed = base |> median(column: \"rsrp\")\ncnt = base |> count(column: \"rsrp\") |> rename(columns: {rsrp: \"samples\"})\n\njoin(tables: {med: med, cnt: cnt}, on: [\"cellLat\", \"cellLon\"])\n  |> filter(fn: (r) => r.samples >= ${minSamples})\n  |> map(fn: (r) => ({r with\n      lat: float(v: r.cellLat), lon: float(v: r.cellLon),\n      quality: if r.rsrp >= -90.0 then \"strong\"\n               else if r.rsrp >= -100.0 then \"medium\"\n               else \"poor\"}))\n  |> group()\n  |> drop(columns: [\"cellLat\", \"cellLon\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d7301f",
                "value": null
              },
              {
                "color": "#fee08b",
                "value": -100
              },
              {
                "color": "#2c7bb6",
                "value": -90
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lat"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "tooltip": true,
                  "viz": false,
                  "legend": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lon"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "tooltip": true,
                  "viz": false,
                  "legend": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 28.5465,
          "lon": 77.1885,
          "zoom": 15
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap",
          "config": {}
        },
        "tooltip": {
          "mode": "details"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Jio \u2014 median RSRP per cell",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 12
                },
                "color": {
                  "field": "rsrp",
                  "fixed": "dark-green"
                },
                "opacity": 0.75,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/square.svg"
                }
              }
            }
          }
        ]
      }
    },
